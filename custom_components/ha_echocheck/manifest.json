{
  "domain": "ha_echocheck",
  "name": "EchoCheck Tank Sensor",
  "codeowners": [
    "@phurth"
  ],
  "config_flow": true,
  "dependencies": [
    "bluetooth",
    "bluetooth_adapters"
  ],
  "documentation": "https://github.com/phurth/ha-echocheck",
